# Пример конфигурации окружения.
# Скопируйте в .env перед запуском: cp .env.example .env

# PostgreSQL (url-postgres)
POSTGRES_DB=url-service-db
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# url-service
URL_SERVICE_PORT=8080
URL_SERVICE_HOST=localhost
HTTP_READ_TIMEOUT=3000
HTTP_CONNECT_TIMEOUT=3000

# moderation-service
MODERATION_SERVICE_PORT=8081
MODERATION_SERVICE_HOST=localhost
